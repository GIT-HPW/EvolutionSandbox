{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git-hpw.github.io/EvolutionSandbox/esip/schemas/open-virfactory-pending-experiment-v1.schema.json",
  "title": "openVirFactory pending world experiment result v1",
  "type": "object",
  "required": ["schemaVersion", "status", "proposal", "audit"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "status": { "const": "pending" },
    "proposal": { "$ref": "world-experiment-proposal-v1.schema.json" },
    "audit": {
      "type": "object",
      "required": ["adapter", "provider", "model", "requestHash"],
      "properties": {
        "adapter": { "const": "open-virfactory.world-experiment.v0" },
        "provider": { "enum": ["anthropic", "ollama"] },
        "model": { "type": "string", "minLength": 1, "maxLength": 128 },
        "requestHash": { "type": "string", "pattern": "^[0-9a-f]{8}$" }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
