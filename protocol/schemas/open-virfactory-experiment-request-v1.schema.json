{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git-hpw.github.io/EvolutionSandbox/esip/schemas/open-virfactory-experiment-request-v1.schema.json",
  "title": "openVirFactory world experiment proposal request v1",
  "type": "object",
  "required": ["schemaVersion", "goal", "context", "newTimelineId"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "goal": { "type": "string", "minLength": 1, "maxLength": 512 },
    "context": {
      "type": "object",
      "required": [
        "universeId", "sourceTimelineId", "sourceTick", "sourceHistoryHash",
        "expectedRevision", "allowedIntents"
      ],
      "properties": {
        "universeId": { "$ref": "#/$defs/id" },
        "sourceTimelineId": { "$ref": "#/$defs/id" },
        "sourceTick": { "type": "integer", "minimum": 0, "maximum": 1000000 },
        "sourceHistoryHash": { "$ref": "#/$defs/hash" },
        "expectedRevision": { "type": "integer", "minimum": 0 },
        "allowedIntents": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5,
          "uniqueItems": true,
          "items": {
            "enum": ["research_focus", "resource_policy", "settlement_policy", "ecology_policy", "cohesion_policy"]
          }
        }
      },
      "additionalProperties": false
    },
    "newTimelineId": { "$ref": "#/$defs/id" }
  },
  "additionalProperties": false,
  "$defs": {
    "id": { "type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{8}$" }
  }
}
