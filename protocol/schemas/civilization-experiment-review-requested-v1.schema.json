{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git-hpw.github.io/EvolutionSandbox/esip/schemas/civilization-experiment-review-requested-v1.schema.json",
  "title": "Civilization experiment review query v1",
