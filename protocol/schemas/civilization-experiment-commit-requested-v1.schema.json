{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://git-hpw.github.io/EvolutionSandbox/esip/schemas/civilization-experiment-commit-requested-v1.schema.json",
  "title": "Civilization experiment commit command v1",
  "type": "object",
  "required": ["context", "proposal", "expectedRevision"],
  "properties": {
    "context": { "allOf": [{ "$ref": "context.schema.json" }, { "type": "object", "properties": { "actorId": true }, "required": ["actorId"] }] },
    "proposal": { "$ref": "world-experiment-proposal-v1.schema.json" },
    "expectedRevision": { "type": "integer", "minimum": 0 }
  },
  "additionalProperties": false
}
